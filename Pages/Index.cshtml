@page
@model IndexModel
@{
    
}

<div>
    @foreach (var item in Model.Todos)
    {
        <div>
            <p><b>Beskrivning:</b> @item.Description</p>
            <p><b>Datum:</b> @item.Date.ToShortDateString()</p>
            <p><b>Ansvarig:</b> @item.Responsible</p>
            <p><b>Klar:</b> @(item.Done ? "Ja" : "Nej")</p>

            @if (!item.Done)
            {
                <form method="post" asp-page-handler="Done">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit">Markera som klar</button>
                </form>
            }
        </div>

        <p>-------------------------------</p>
    }

    <form method="post" asp-page-handler="Add">
        <input asp-for="NewTodo.Description" placeholder="Beskrivning" />
        <input asp-for="NewTodo.Date" type="date" />
        <input asp-for="NewTodo.Responsible" placeholder="Ansvarig" />
        <button type="submit">Add</button>
    </form>
</div>
